# This is a template to base your .floo entry script for some fireplace on.
# It demonstrates how to configure floo to create a named tmux session with
# two windows, one opening the project directory in the default editor, 
# the other just running a terminal session in the directory.
# You may also choose to add things like sourcing specific .env files
# or similar in each session.

tmux has-session -t "$FLOO_NAME" 2>/dev/null

if [ $? != 0 ]; then
    echo "Creating new session: $FLOO_NAME"

    # Create the session in the fireplace's directory
    tmux new-session -d -s "$FLOO_NAME" -c "$FLOO_DIR"

    # Run command in Window 1
    tmux send-keys -t "$FLOO_NAME":0 "$EDITOR ." C-m

    # Create the second window
    tmux new-window -t "$FLOO_NAME" -c "$FLOO_DIR"

    # Reset focus to the first window
    tmux select-window -t "$FLOO_NAME":1
else
    echo "Session $FLOO_NAME already exists."
fi

# 2. Handle Attachment/Transition
if [ -n "$TMUX" ]; then
    # If we are already inside tmux, switch the current client to the new session
    # This prevents the script from hanging or closing prematurely
    echo "Switching current tmux client to $FLOO_NAME..."
    tmux switch-client -t "$FLOO_NAME"
else
    # If we are in a regular terminal, attach normally
    echo "Attaching to $FLOO_NAME..."
    tmux attach-session -t "$FLOO_NAME"
fi
